# =====================================================================
# ALVO PRINT 3D — VARIÁVEIS DE AMBIENTE
# Copie para ".env.local" (desenvolvimento) e configure as mesmas
# variáveis no Netlify: Site configuration → Environment variables.
# NUNCA coloque estes valores no código nem os envie para o GitHub.
# =====================================================================

# --- Endereço público do site (sem barra final) ---
NEXT_PUBLIC_SITE_URL=https://www.alvoprint3d.pt

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Chave pública "anon"/"publishable" — pode estar no navegador (protegida por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave "service_role"/"secret" — APENAS no servidor. Nunca com prefixo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --- Meshy AI (https://www.meshy.ai/developers/keys) — APENAS no servidor ---
MESHY_API_KEY=

# --- Painel administrativo ---
# Palavra-passe de acesso a /admin (mínimo 12 caracteres)
ADMIN_PASSWORD=
# Segredo aleatório longo para assinar a sessão (ex.: openssl rand -hex 32)
ADMIN_SESSION_SECRET=

# --- Proteção anti-abuso (opcional mas recomendado, gratuito) ---
# Cloudflare Turnstile: https://dash.cloudflare.com → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Assistente com IA generativa (opcional, PAGO por utilização) ---
# Deixe vazio para usar apenas o assistente gratuito com respostas predefinidas.
ASSISTANT_ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-5-5
